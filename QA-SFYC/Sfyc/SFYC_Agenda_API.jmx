<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="SFYC Agenda API - Plan de Pruebas" enabled="true">
      <stringProp name="TestPlan.comments">Sistema: SFyC NextGen - Agenda QA Cluster | Ejecutar: jmeter -n -t SFYC_Agenda_API.jmx -l results/results.jtl -Jthreads=5 -Jrampup=15 -Jloops=3</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables Globales" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_URL_DATA" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL_DATA</stringProp>
            <stringProp name="Argument.value">${__P(base_url_data,data.qa-cluster.sfycnextgen.com.mx)}</stringProp>
          </elementProp>
          <elementProp name="BASE_URL_MULE" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL_MULE</stringProp>
            <stringProp name="Argument.value">${__P(base_url_mule,mgcl-api-megacable-sfyc.dev.mega-mule.mx)}</stringProp>
          </elementProp>
          <elementProp name="BASE_URL_INN" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL_INN</stringProp>
            <stringProp name="Argument.value">${__P(base_url_inn,inn-wsdiqueconsumer-sys-api.dev.mega-mule.mx)}</stringProp>
          </elementProp>
          <elementProp name="BRANCH_ID" elementType="Argument">
            <stringProp name="Argument.name">BRANCH_ID</stringProp>
            <stringProp name="Argument.value">${__P(branch_id,41)}</stringProp>
          </elementProp>
          <elementProp name="SUBSCRIBER_NUMBER" elementType="Argument">
            <stringProp name="Argument.name">SUBSCRIBER_NUMBER</stringProp>
            <stringProp name="Argument.value">${__P(subscriber_number,1521390)}</stringProp>
          </elementProp>
          <elementProp name="MAC_ADDRESS" elementType="Argument">
            <stringProp name="Argument.name">MAC_ADDRESS</stringProp>
            <stringProp name="Argument.value">${__P(mac_address,48575443DEFD32AB)}</stringProp>
          </elementProp>
          <elementProp name="BRANCH_GROUP_ID" elementType="Argument">
            <stringProp name="Argument.name">BRANCH_GROUP_ID</stringProp>
            <stringProp name="Argument.value">041</stringProp>
          </elementProp>
          <elementProp name="SUBSCRIBER_CONTRACT" elementType="Argument">
            <stringProp name="Argument.name">SUBSCRIBER_CONTRACT</stringProp>
            <stringProp name="Argument.value">0411521390</stringProp>
          </elementProp>
          <elementProp name="THREADS" elementType="Argument">
            <stringProp name="Argument.name">THREADS</stringProp>
            <stringProp name="Argument.value">${__P(threads,5)}</stringProp>
          </elementProp>
          <elementProp name="RAMPUP" elementType="Argument">
            <stringProp name="Argument.name">RAMPUP</stringProp>
            <stringProp name="Argument.value">${__P(rampup,15)}</stringProp>
          </elementProp>
          <elementProp name="LOOPS" elementType="Argument">
            <stringProp name="Argument.name">LOOPS</stringProp>
            <stringProp name="Argument.value">${__P(loops,3)}</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- HTTP Header Manager Global -->
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager - Global" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="Content-Type" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="Accept" elementType="Header">
            <stringProp name="Header.name">Accept</stringProp>
            <stringProp name="Header.value">application/json, text/plain, */*</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>

      <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="HTTP Cookie Manager" enabled="true">
        <boolProp name="CookieManager.clearEachIteration">true</boolProp>
      </CookieManager>
      <hashTree/>

      <CacheManager guiclass="CacheManagerGui" testclass="CacheManager" testname="HTTP Cache Manager" enabled="true">
        <boolProp name="clearEachIteration">true</boolProp>
        <boolProp name="useExpires">false</boolProp>
      </CacheManager>
      <hashTree/>

      <!-- ================================================================
           THREAD GROUP: Flujo Principal - Consulta Suscriptor + Agenda
      ================================================================ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TG - Flujo Consulta Suscriptor y Agenda" enabled="true">
        <stringProp name="TestPlan.comments">Flujo: GetGeneralData -> Equipos -> Contratos -> Paquete -> Detalles -> Quejas -> Agenda</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${LOOPS}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${THREADS}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${RAMPUP}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
      </ThreadGroup>
      <hashTree>

        <!-- ============================================================
             TC01 - DATOS GENERALES DEL SUSCRIPTOR
        ============================================================ -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC01 - Datos Generales del Suscriptor" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Defaults - data.qa-cluster" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
            <stringProp name="HTTPSampler.domain">${BASE_URL_DATA}</stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.port">443</stringProp>
            <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
            <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
          </ConfigTestElement>
          <hashTree/>

          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST - GetGeneralData" enabled="true">
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{"branchId":${BRANCH_ID},"subscriberNumber":${SUBSCRIBER_NUMBER}}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.path">/subscribers-process/api/GetGeneralData</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <org.apache.jmeter.extractor.json.jsonpath.JSONPathExtractor guiclass="JSONPathExtractorGui" testclass="JSONPathExtractor" testname="Extractor - id_suscriptor" enabled="true">
              <stringProp name="JSONPathExtractor.referenceName">ID_SUSCRIPTOR</stringProp>
              <stringProp name="JSONPathExtractor.jsonPathExprs">$.id_suscriptor</stringProp>
              <stringProp name="JSONPathExtractor.defaultValues">ID_NO_ENCONTRADO</stringProp>
              <stringProp name="JSONPathExtractor.match_no">0</stringProp>
            </org.apache.jmeter.extractor.json.jsonpath.JSONPathExtractor>
            <hashTree/>
            <org.apache.jmeter.extractor.json.jsonpath.JSONPathExtractor guiclass="JSONPathExtractorGui" testclass="JSONPathExtractor" testname="Extractor - id_domicilio" enabled="true">
