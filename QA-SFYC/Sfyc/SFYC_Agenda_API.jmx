              <boolProp name="ISREGEX">false</boolProp>
            </org.apache.jmeter.assertions.JSONPathAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Assert - Tiempo menor a 5000ms" enabled="true">
              <stringProp name="DurationAssertion.duration">5000</stringProp>
