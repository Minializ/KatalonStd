              <stringProp name="JSONPathExtractor.jsonPathExprs">$.id_domicilio</stringProp>
              <stringProp name="JSONPathExtractor.defaultValues">DOMICILIO_NO_ENCONTRADO</stringProp>
              <stringProp name="JSONPathExtractor.match_no">0</stringProp>
            </org.apache.jmeter.extractor.json.jsonpath.JSONPathExtractor>
            <hashTree/>
            <org.apache.jmeter.extractor.json.jsonpath.JSONPathExtractor guiclass="JSONPathExtractorGui" testclass="JSONPathExtractor" testname="Extractor - id_colonia" enabled="true">
              <stringProp name="JSONPathExtractor.referenceName">ID_COLONIA</stringProp>
              <stringProp name="JSONPathExtractor.jsonPathExprs">$.id_colonia</stringProp>
              <stringProp name="JSONPathExtractor.defaultValues">COLONIA_NO_ENCONTRADO</stringProp>
              <stringProp name="JSONPathExtractor.match_no">0</stringProp>
            </org.apache.jmeter.extractor.json.jsonpath.JSONPathExtractor>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert - HTTP 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">GetGeneralData debe retornar HTTP 200</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <org.apache.jmeter.assertions.JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Assert - id_suscriptor presente" enabled="true">
              <stringProp name="JSON_PATH">$.id_suscriptor</stringProp>
              <stringProp name="EXPECTED_VALUE"></stringProp>
              <boolProp name="JSONVALIDATION">false</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">false</boolProp>
            </org.apache.jmeter.assertions.JSONPathAssertion>
            <hashTree/>
            <org.apache.jmeter.assertions.JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Assert - sucursal coincide con solicitada" enabled="true">
              <stringProp name="JSON_PATH">$.sucursal</stringProp>
              <stringProp name="EXPECTED_VALUE">41</stringProp>
              <boolProp name="JSONVALIDATION">true</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">false</boolProp>
            </org.apache.jmeter.assertions.JSONPathAssertion>
            <hashTree/>
            <org.apache.jmeter.assertions.JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Assert - suscriptor coincide con solicitado" enabled="true">
              <stringProp name="JSON_PATH">$.suscriptor</stringProp>
              <stringProp name="EXPECTED_VALUE">1521390</stringProp>
              <boolProp name="JSONVALIDATION">true</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">false</boolProp>
            </org.apache.jmeter.assertions.JSONPathAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Assert - Tiempo menor a 5000ms" enabled="true">
              <stringProp name="DurationAssertion.duration">5000</stringProp>
            </DurationAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>

        <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time 1s" enabled="true">
          <stringProp name="ConstantTimer.delay">1000</stringProp>
        </ConstantTimer>
        <hashTree/>

        <!-- ============================================================
             TC02 - DATOS TECNICOS DE EQUIPOS
        ============================================================ -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC02 - Datos Tecnicos de Equipos" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST - GetEquipmentsTechnicalData" enabled="true">
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
